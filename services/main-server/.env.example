# Signal Alpha main-server — 로컬 실행 env 예시
# 복사: cp .env.example .env   (실제 키는 .env 에만 — .env 는 .gitignore 로 커밋 금지)
# 실행: uv run uvicorn app.main:app --env-file .env --reload --port 8000

# --- DB ---
# 로컬 dev DB(sa-dev 컨테이너, 포트 55432). 마이그레이션·시드·발행리포트(005930)·관리자 준비됨.
DATABASE_URL=postgresql://signal_alpha:pw@localhost:55432/signal_alpha
# docker-compose postgres 사용 시:
# DATABASE_URL=postgresql://signal_alpha:signal_alpha_password@localhost:5432/signal_alpha

# --- 토큰 / CORS ---
AUTH_SECRET_KEY=dev-main-server-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- 구독 / 무료 열람 쿼터 ---
SUBSCRIPTION_PRICE_KRW=9900
SUBSCRIPTION_PLAN_TYPE=monthly_9900
FREE_REPORT_QUOTA=3

# --- 포트원 V2 REST: 본인인증 + 결제 검증 ---
# 항상 real 모드(dev 폴백 없음). api_secret 비면 본인인증/결제 검증이 오류로 실패한다.
# 인증헤더 `Authorization: PortOne {secret}`, 베이스 https://api.portone.io
PORTONE_API_BASE=https://api.portone.io
PORTONE_API_SECRET=
PORTONE_STORE_ID=

# --- 소셜 OAuth (토큰 + 고유 id만 사용, 개인정보 미수집) ---
# 설정한 provider 만 실 OAuth, 비우면 dev 모드. NAVER_DATALAB_* 와는 별개의 앱.
# ⚠️ APP_ENV=production 에서 자격을 비우면 소셜 로그인은 dev 모드로 떨어지지 않고 fail-closed(오류)다
#    — dev 모드 provider_user_id 가 클라이언트 code 해시라 계정 탈취에 악용될 수 있어서다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- 신뢰 프록시(레이트리밋·관리자 잠금 IP 판정) ---
# rate limit·로그인 잠금이 클라이언트 IP 를 정하는 방식. 0(기본)=X-Forwarded-For 무시(소켓 peer만
# 신뢰) → 헤더 위조로 우회 불가. 리버스 프록시/L7 LB 뒤(예: GKE GCE ingress)면 프록시 홉 수(보통 1)로
# 설정해야 XFF 우측에서 그만큼 벗겨낸 실클라이언트를 쓴다. 잘못 크게 잡으면 위조에 다시 취약해지니 주의.
TRUSTED_PROXY_COUNT=0
