# Signal Alpha web(Next.js) — 로컬 env 예시
# 복사: cp .env.example .env.local   (Next.js 가 .env.local 자동 로드, 커밋 금지)
# 실행: npm run dev

# 백엔드 API 베이스 URL
NEXT_PUBLIC_MAIN_API_BASE_URL=http://localhost:8000

# 포트원 V2 — Store ID + 채널키. STORE_ID 비우면 프론트 dev 모드(가상 본인인증/결제).
# 채널키: 본인인증=KG이니시스 통합인증 채널키, 결제=이니시스 일반결제 채널키
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_IDENTITY=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_PAYMENT=
