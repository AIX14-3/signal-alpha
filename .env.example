# Signal Alpha local development environment.
# Copy this file to .env for local Docker Compose runs.
# Production should use managed infrastructure values instead of these local defaults.

COMPOSE_PROJECT_NAME=signal-alpha
SERVICE_VERSION=0.1.0

# Local PostgreSQL container (일반 postgres:16 — 임베딩/pgvector 제거로 vector 확장 불필요.
# 배포 DB 는 GCP Cloud SQL).
POSTGRES_DB=signal_alpha
POSTGRES_USER=signal_alpha
POSTGRES_PASSWORD=signal_alpha_password
POSTGRES_PORT=5432
# 기본(owner) 접속 URL. 로컬은 이 값 하나로 worker/backend/migrate 모두 동작한다.
DATABASE_URL=postgresql://signal_alpha:signal_alpha_password@postgres:5432/signal_alpha

# --- worker/backend 권한 분리(Model A) ---
# 컷오버 전까지 아래 3개는 비워두면 compose 가 owner(DATABASE_URL)로 폴백한다.
# 컷오버 시: 마이그레이션으로 만든 signal_worker / signal_backend 롤에
#   `ALTER ROLE ... PASSWORD '...';` 로 비밀번호를 부여한 뒤(콘솔/out-of-band),
#   아래 값을 해당 롤로 채워 각 서비스가 제한 권한으로 접속하게 한다.
#   - worker  : base 테이블 DML (수집/분석/시그널 적재)
#   - backend : 소유 테이블 DML + api.* 읽기 view 만 (worker 테이블 직접 권한 없음)
#   - migrate : owner (DDL)
# WORKER_DATABASE_URL=postgresql://signal_worker:CHANGE_ME@postgres:5432/signal_alpha
# BACKEND_DATABASE_URL=postgresql://signal_backend:CHANGE_ME@postgres:5432/signal_alpha
# MIGRATE_DATABASE_URL=postgresql://signal_alpha:signal_alpha_password@postgres:5432/signal_alpha

# Service ports.
MAIN_SERVER_PORT=8000
AGENT_WORKER_PORT=8011
WEB_PORT=3000

# NOTE: main-server(backend)는 worker 에 런타임 의존하지 않으므로 AGENT_WORKER_BASE_URL 를
#       더 이상 사용하지 않는다(워커 산출물은 DB api.* view 로 읽음). 항목 자체를 제거했다.

# Browser-facing frontend API URL.
NEXT_PUBLIC_MAIN_API_BASE_URL=http://localhost:8000

# External API keys for local development.
# Keep real values in .env only. Do not commit secrets.
LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DART_API_KEY=
DART_BASE_URL=https://opendart.fss.or.kr/api
DART_TIMEOUT_SECONDS=10
DART_PAGE_SIZE=100
DART_FETCH_DOCUMENTS=true
DART_MAX_RETRIES=2
DART_RETRY_BACKOFF_SECONDS=0.5
DART_USE_LLM=false
DART_LLM_HIGH_IMPACT_ONLY=true
DART_LLM_PROVIDER=gemini
DART_LLM_MODEL=gemini-2.0-flash
DART_LLM_TIMEOUT_SECONDS=20

# Report RAG agent LLM 종합 (provider/key는 위 OPENAI_*/GEMINI_* 공유 설정 재사용)
REPORT_USE_LLM=false
REPORT_LLM_PROVIDER=gemini
REPORT_LLM_MODEL=gemini-2.0-flash
REPORT_LLM_TIMEOUT_SECONDS=20

# 끝단 RISK 종합(SYNTHESIZE 단계) LLM. 끄면(false) 결정론 템플릿 내러티브로 폴백.
# MVP: provider=gemini + GEMINI_API_KEY 주입 + on. 모델은 Gemini 3.x(좋은 모델) 사용:
#   SYNTHESIS_LLM_MODEL=gemini-3.1-pro-preview  (현행 3.x Pro. gemini-3-pro-preview 는
#   2026-03 종료됨. 배치 비용을 줄이려면 flash 계열로 교체 가능.)
#   (대안: SYNTHESIS_LLM_PROVIDER=openai, SYNTHESIS_LLM_MODEL=gpt-4o-mini, OPENAI_API_KEY)
# anthropic 등 그 외 provider 는 미지원 → 자동으로 결정론 폴백.
# 클라이언트는 v1beta :generateContent (analyzers/dart/llm.py 의 GeminiGenerateContentClient).
SYNTHESIS_USE_LLM=false
SYNTHESIS_LLM_PROVIDER=gemini
SYNTHESIS_LLM_MODEL=gemini-3.1-pro-preview
SYNTHESIS_LLM_TIMEOUT_SECONDS=30

# ML_INFER 변동성 모델 선택(게이트 통과 모델 화이트리스트). 기본 = ML 3종 + DL 1종(tcn).
# lightgbm 은 scikit-learn 의존으로 이미지가 무거워져 기본 제외(쓰려면 vol-models[garch,lgbm]
# 설치 + 여기에 lightgbm 추가). tcn(경량 DL)은 vol-models[dl](CPU torch) 설치 시 가용,
# 미설치면 자동 skip. GPU 모델(kronos/chronos2)은 torch+repo 미설치 시 자동 skip.
# OHLCV 이력이 없으면 ML_INFER 는 consensus-only 폴백(정상). meta_learner.json 없으면 균등 가중.
ML_GATE_PASSED_MODELS=ewma,har_rv,garch,tcn
ML_HORIZON=10
ML_LOOKBACK_SESSIONS=400

# Price 수집 데몬 — Kiwoom REST API (agent-worker 내장 백그라운드 태스크).
# 현재 키는 모의투자용(만료 2026-09-06) → mockapi 도메인 사용.
# 실전투자용 키 발급 후 KIWOOM_API_BASE=https://api.kiwoom.com 으로 교체.
PRICE_COLLECTOR_ENABLED=true
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_API_BASE=https://mockapi.kiwoom.com
PRICE_POLL_INTERVAL_SEC=60
PRICE_FLOW_DELAY_AFTER_CLOSE_MIN=30
KIWOOM_MIN_REQUEST_INTERVAL_SEC=0.25

# Report RAG PDF storage.
# Use "gcs" for the shared/default backend, or "local" for local test files.
REPORT_STORAGE_BACKEND=gcs
GCP_PROJECT_ID=
GCS_REPORT_BUCKET=signal-alpha-reports
# Local development can use Application Default Credentials or a service-account file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
REPORT_LOCAL_STORAGE_DIR=data/report-storage

# Legacy Report S3 settings. The canonical queue path uses GCS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_REPORT_BUCKET=signal-alpha-reports

# Naver DataLab API — 검색어 트렌드 수집 (DataLab 파트 전용)
# 네이버 개발자 센터 > 내 애플리케이션 > Signal-Alpha-DataLab 앱
# 일일 쿼터(기본 1,000건)를 DataLab 파트가 독점 사용
NAVER_DATALAB_CLIENT_ID=
NAVER_DATALAB_CLIENT_SECRET=

# Naver DataLab API — 채용 트렌드 기준선 수집 (HiringKeywordGenerator 전용)
# 네이버 개발자 센터 > 내 애플리케이션 > Signal-Alpha-Hiring 앱 (별도 등록 필수)
# DataLab 파트와 쿼터를 공유하면 429 에러 위험 → 반드시 분리
HIRING_DATALAB_CLIENT_ID=
HIRING_DATALAB_CLIENT_SECRET=

# ===== 신규 기획: 인증/결제/소셜 (main-server) =====
# 자세한 콘솔 등록값·콜백 URL은 docs/spec/third-party-integration-setup.md 참조.

# 토큰 / 구독 / 무료 열람 쿼터
AUTH_SECRET_KEY=dev-main-server-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ALLOW_ORIGINS=http://localhost:3000
SUBSCRIPTION_PRICE_KRW=9900
SUBSCRIPTION_PLAN_TYPE=monthly_9900
FREE_REPORT_QUOTA=3

# 포트원 V2 — 본인인증 + 결제. api_secret/store_id 비우면 dev 모드(외부호출 없이 모의값).
# 백엔드: PORTONE_API_SECRET(필수)·PORTONE_STORE_ID / 프론트: NEXT_PUBLIC_PORTONE_* (브라우저 노출).
PORTONE_API_BASE=https://api.portone.io
PORTONE_API_SECRET=
PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_IDENTITY=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_PAYMENT=

# 소셜 로그인 OAuth — 토큰+고유 id만 사용(개인정보 미수집). NAVER_DATALAB_* 와 별개 앱.
# 콜백 URL: http://localhost:3000/auth/callback/{naver|google|kakao}
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 프론트(브라우저 노출) — 인증요청 URL 생성용 client_id(공개값). kakao 는 REST API 키.
NEXT_PUBLIC_NAVER_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_KAKAO_CLIENT_ID=
